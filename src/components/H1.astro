---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h1"> & {
  margins?: boolean;
};

const { class: c, margins = true, ...rest } = Astro.props;

const classes = [
  "font-serif",
  "font-medium",
  "text-4xl",
  "md:text-5xl",
  margins ? "mb-6" : null,
  margins ? "md:mb-8" : null,
]
  .filter((x) => x != null)
  .concat(c?.split(" ") ?? []);
---

<h1 class:list={classes} {...rest}><slot /></h1>
